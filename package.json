{
  "name": "restaurant-qr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:db": "node scripts/test-db.mjs",
    "test:pricing": "node --no-warnings scripts/test-pricing.mjs",
    "test": "npm run test:db && npm run test:pricing",
    "create-admin": "node --env-file=.env.local scripts/create-admin.mjs",
    "db:push": "supabase db push",
    "gen:types": "supabase gen types typescript --linked --schema public > src/lib/database.types.ts",
    "e2e:live": "node --env-file=.env.local scripts/e2e-live.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "next": "15.5.29",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "supabase": "^3.2.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
